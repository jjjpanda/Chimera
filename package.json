{
  "name": "chimera",
  "version": "6.0.2",
  "description": "a microservices based security camera system",
  "engines": {
    "npm": ">=7.0.0",
    "node": ">=22.12.0"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "pm2": {
      "js-yaml": "^4.3.1"
    }
  },
  "workspaces": [
    "command",
    "gateway",
    "lib",
    "livestream",
    "memory",
    "object",
    "schedule",
    "storage"
  ],
  "scripts": {
    "build": "npm-run-all -s --npm-path npm \"build:*\"",
    "build:command": "npm run build --workspace=command",
    "prepare:database": "node chimera/prepareDatabase.js",
    "lint": "eslint --ext .jsx --ext .js \".\" -o eslint/lintOutput.html -f html",
    "lint:ci": "eslint --ext .jsx --ext .js \".\" --max-warnings 150",
    "lintfix": "eslint --ext .jsx --ext .js \".\" -o eslint/lintOutput.html -f html --fix",
    "clean": "rimraf --glob '**/log' '**/eslint' '**/coverage' '**/node_modules' '**/package-lock.json' '**/npm-shrinkwrap.json'",
    "test": "jest",
    "e2e:install": "npm run e2e:install --workspace=command",
    "e2e:command": "npm run e2e --workspace=command",
    "devprep": "npm run prerelease && npm run build",
    "prerelease": "npm run clean && npm install",
    "release": "npm-run-all -s --npm-path npm build test",
    "postrelease": "npm install --omit=dev && npm shrinkwrap",
    "setup": "npm install && npm run build",
    "preflight": "node chimera/preflight.js",
    "predocker:build": "node chimera/preflight.js --check",
    "docker:build": "node chimera/compose.js build",
    "predocker:up": "node chimera/preflight.js --check",
    "docker:up": "node chimera/compose.js up -d",
    "docker:down": "node chimera/compose.js down",
    "docker:logs": "node chimera/compose.js logs -f",
    "predocker:restart": "node chimera/preflight.js --check",
    "docker:restart": "node chimera/compose.js restart",
    "docker:rebuild": "npm-run-all -s --npm-path npm docker:down docker:build docker:up",
    "docker:delete": "node chimera/compose.js down -v",
    "watchdog": "node chimera/watchdog.js",
    "watchdog:once": "node chimera/watchdog.js --once"
  },
  "dependencies": {
    "command": "file:./command",
    "dotenv": "^16.4.0",
    "gateway": "file:./gateway",
    "heartbeat": "jjjpanda/heartbeat#v1.4.1",
    "lib": "file:./lib",
    "livestream": "file:./livestream",
    "memory": "file:./memory",
    "npm-run-all": "^4.1.5",
    "object": "file:./object",
    "pg": "^8.11.0",
    "pm2": "^7.0.3",
    "rimraf": "6.1.3",
    "schedule": "file:./schedule",
    "storage": "file:./storage"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.16.7",
    "eslint": "^8.2.0",
    "eslint-plugin-react": "^7.27.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "supertest": "^7.2.2"
  }
}
