# Chimera
# *** = optional, leave blank after =
# "# default" = the value shown is already correct, leave it alone
# FILEPATH = absolute path to a file, FOLDERPATH = absolute path to a folder
# (a | b) = pick one; HOST vars take no trailing slash
#
# The image pins TZ=UTC. Non-UTC misaligns clips/zips/frames.

NODE_ENV = (production | development)
chimeraInstances = pm2 cluster size; "max", -1, or an integer >= 0. Anything but 1 is a cluster and forces memory_ON=true.

# Container limits, read by docker-compose only. Defaults 2g / 512 fit one instance; a cluster needs both raised.
# chimera_MEM_LIMIT = 4g
# chimera_PIDS_LIMIT = 1024

alert_URL = Webhook url for health, task, watchdog, and detection alerts; blank sends none and skips the heartbeat monitor ***
admin_alert_URL = Webhook url for admin alerts; blank sends none ***
alert_TZ = IANA tz for times in webhook alerts, e.g. America/New_York (default UTC). Display only. ***

SECRETKEY = Auth secret key for hashing, min 32 characters

##################################################################
# Gateway
##################################################################

gateway_PORT = Gateway http port (must be 80 when certbot_ON=true)
gateway_HOST = https://gateway.server.example or http://127.0.0.1:8080 (protocol defaults to https:// if omitted)
# gateway_HOST is also the target of the https:// redirect. Every http:// visitor lands on this name and gateway_PORT_SECURE, whatever host they typed.

gateway_PORT_SECURE = Gateway https port (default 443) ***
certbot_ON = (true | false) Get and renew Let's Encrypt certs automatically. Needs gateway_HOST to be a public domain that points at this machine, with port 80 open. Leave false to supply your own certs below.
# Without the two FILEPATHs below, the gateway looks for the certs at /etc/letsencrypt/live/<gateway_HOST domain>/{privkey,fullchain}.pem
privateKey_FILEPATH = Custom TLS private key path (set both FILEPATHs, or neither) ***
certificate_FILEPATH = Custom TLS certificate path (set both FILEPATHs, or neither) ***
gateway_HTTPS_Redirect = (true | false) Send http:// visitors to https://. Behind a proxy, also set gateway_TRUST_PROXY=true, or every page redirects to itself. ***
gateway_TRUST_PROXY = (false | true | how many proxies) Trust X-Forwarded-For and X-Forwarded-Proto from the proxy in front (nginx: proxy_set_header X-Forwarded-Proto $scheme). ***
# false: the gateway sees every visitor behind that proxy as one address. They share one per-IP login limit, and the redirect cannot tell that the visit was already https.
# true: one proxy in front. Each visitor gets their own address and their own limit, and the redirect works. Set this only when nothing but the proxy can reach gateway_PORT, because anyone who reaches it directly can forge both headers.
# a number: that many proxies in front, counted from the visitor. Use 2 for a CDN in front of your own nginx — with 1 the gateway reads nginx's entry, which says http, and redirects an https visit back to itself.

##################################################################
# Command
##################################################################

command_ON = (true | false)
command_PROXY_ON = (true | false)
command_PORT = Command http port
command_HOST = https://command.server.example or http://127.0.0.1:8081
command_COOKIE_SECURE = (true | false) Secure flag on the auth cookie. Set true when browsers reach the site over HTTPS, whatever terminates TLS. Set false only for a plain-HTTP deploy, where browsers drop a Secure cookie and the login breaks.
setup_TOKEN = Token gating /authorization/setup, min 32 characters. Creates the first admin only when none exists; cannot reset an existing one.

##################################################################
# Schedule
##################################################################

schedule_ON = (true | false)
schedule_PROXY_ON = (true | false)
schedule_PORT = Port for schedule server
schedule_HOST = https://schedule.server.example or http://127.0.0.1:8082

scheduler_AUTH = Authorization token for scheduler server to bypass auth (keep secret), min 32 characters
scheduler_TRUSTED_SOURCES = Comma-separated proxy-addr sources allowed to use scheduler_AUTH, e.g. "loopback" or "10.0.0.0/8" (default "loopback"). Set this when storage_HOST is off-box, or scheduled tasks 401. An unparseable value crash-loops every service. ***
# Widen only if storage runs on another machine: scheduler_AUTH then crosses your network unencrypted, and it grants admin access.

##################################################################
# Storage
##################################################################

storage_ON = (true | false)
storage_PROXY_ON = (true | false)
storage_PORT = Port for storage server
storage_HOST = https://storage.server.example or http://127.0.0.1:8083

storage_FOLDERPATH = /mnt/storage/  # default; base shared file path, leave as is under docker
storage_MOTION_CONF_FILEPATH = /etc/motion/motion.conf  # default; motion conf path, leave as is under docker
storage_MAX_GB = Storage quota in GB. WARNING: arms an hourly job that permanently deletes oldest footage past 90% of this cap. Blank disables. ***

ffmpeg_FILEPATH = /usr/bin/ffmpeg  # default; ffmpeg executable, leave as is under docker
ffprobe_FILEPATH = /usr/bin/ffprobe  # default; ffprobe executable, leave as is under docker

##################################################################
# Livestream
##################################################################

livestream_ON = (true | false)
livestream_PROXY_ON = (true | false)
livestream_PORT = Port for livestream server
livestream_HOST = https://livestream.server.example or http://127.0.0.1:8084

livestream_FOLDERPATH = /mnt/storage/  # default; base shared folder path, leave as is under docker

##################################################################
# Object
##################################################################

object_ON = (true | false) Needs livestream_ON=true, since object watches the livestream feeds. Also requires livestream_FOLDERPATH (frames in) and storage_FOLDERPATH (captures out), even when storage_ON=false.
object_PROXY_ON = (true | false)
object_PORT = Port for object detection server
object_HOST = https://object.server.example or http://127.0.0.1:8085

object_CONFIDENCE = Detection confidence threshold 0-1 (default 0.5) ***
object_INTERVAL_MS = Milliseconds between scans per camera (default 5000) ***
object_MODEL_URL = Override URL for the YOLOX ONNX model; requires object_MODEL_SHA256. Blank downloads yolox_tiny.onnx (~20 MB) on first boot ***
object_MODEL_SHA256 = SHA256 of the model at object_MODEL_URL; required when that is set, blank otherwise
object_INPUT_SIZE = Model input square size, match the model (default 416) ***
object_ALERT_ON = Webhook alerts on detection to alert_URL (true | text | false, default true). true attaches a JPEG of the frame; text sends the summary line only ***
object_MAX_CAPTURES = Max capture images to retain on disk (default 500) ***
object_PRUNE_INTERVAL_MS = Milliseconds between capture-pruning sweeps (default 300000) ***

##################################################################
# Memory
##################################################################

memory_ON = (true | false)
memory_PORT = Port for memory socket
memory_HOST = https://memory.socket.example or http://127.0.0.1:8086

memory_AUTH_TOKEN = Header token to connect to memory socket, min 32 characters

##################################################################
# Database
##################################################################

database_NAME = postgres database name; any name, the container creates it on first boot
database_USER = postgres user; any user, the container creates it on first boot
database_PASSWORD = postgres password, min 32 characters; any password, the container sets it on first boot
database_HOST = postgres  # default; bare hostname, no protocol — the database is a side container, never localhost
database_PORT = 5432  # default; postgres server port, leave as is under docker

##################################################################
# Watchdog — runs on the host, outside Docker
##################################################################

watchdog_INTERVAL_MS = Milliseconds between health polls, minimum 5000 (default 60000); ignored by watchdog:once, where the scheduler sets the interval ***
watchdog_FAILURES = Consecutive failed polls before the watchdog acts (default 3) ***